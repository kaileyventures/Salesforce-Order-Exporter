{
  "manifest_version": 3,
  "name": "Salesforce Order Exporter",
  "version": "1.1",
  "description": "Export Salesforce orders easily based on Last Order ID and Status.",
  "permissions": [
    "activeTab",
    "cookies",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "*://*.salesforce.com/*",
    "*://*.force.com/*",
    "*://*.visualforce.com/*",
    "*://*.cloudforce.com/*"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "Toggle Salesforce Order Exporter",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.salesforce.com/*",
        "*://*.force.com/*",
        "*://*.visualforce.com/*",
        "*://*.cloudforce.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.css", "popup.js", "icon.png"],
      "matches": [
        "*://*.salesforce.com/*",
        "*://*.force.com/*",
        "*://*.visualforce.com/*",
        "*://*.cloudforce.com/*"
      ]
    }
  ]
}

